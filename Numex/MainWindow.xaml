<Window x:Class="Numex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Numex"
        mc:Ignorable="d"
        Title="Numex" Height="500" Width="800">
    <Grid>
        <!-- Menu -->
        <Menu x:Name="Menu" Height="25" VerticalAlignment="Top">
            <MenuItem Header="File">
                <MenuItem Header="Метод дихотомии" Click="DichotomyShow" />
                <MenuItem Header="Методы решения СЛАУ" />
                <MenuItem Header="Метод золотого сечения" />
                <MenuItem Header="Метод Ньютона" Click="NewtonShow" />
                <Separator />
                <MenuItem Header="Exit" />
            </MenuItem>
            <MenuItem Header="Edit" />
            <MenuItem Header="View" />

            <!-- Dichotomy method -->
            <MenuItem x:Name="DichotomyMenuItem" Header="Метод дихотомии" Visibility="Collapsed">
                <MenuItem Header="Найти корень" Click="DichotomyCalculate" />
                <MenuItem Header="Построить график" Click="DichotomyBuildPlot" />
                <MenuItem Header="Сброс" Click="DichotomyReset" />
            </MenuItem>
            
            <!-- Newton method -->
            <MenuItem x:Name="NewtonMenuItem" Header="Метод Ньютона" Visibility="Collapsed">
                <MenuItem Header="Найти корень" Click="NewtonCalculate"/>
                <MenuItem Header="Построить график" Click="NewtonBuildPlot"/>
                <MenuItem Header="Сброс" Click="NewtonReset"/>
            </MenuItem>
        </Menu>

        <!-- Content window for different tasks -->
        <ContentControl x:Name="MainContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Margin="0,25,0,0" />
    </Grid>
</Window>