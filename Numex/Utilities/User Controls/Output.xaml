<UserControl x:Class="Numex.Utilities.User_Controls.Output"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:gif="clr-namespace:XamlAnimatedGif;assembly=XamlAnimatedGif"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
  <Grid>
    <Border BorderBrush="Gray" BorderThickness="1" Margin="0,15,0,0" Height="35">
      <Grid>
        <Image x:Name="Gif" gif:AnimationBehavior.SourceUri="/Resources/Gif/circleLoading.gif" Visibility="Collapsed" />
        <TextBlock x:Name="TextBlock"
                   Text="" FontSize="14"
                   VerticalAlignment="Center"
                   Height="Auto" />
      </Grid>
    </Border>
  </Grid>
</UserControl>