<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Flee" Version="2.0.0" />
      <PackageReference Include="ScottPlot.WinForms" Version="5.1.57" />
      <PackageReference Include="ScottPlot.WPF" Version="5.1.57" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="ResourcesDictionary.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
        <Link>Resources\ResourcesDictionary.xaml</Link>
      </Page>
      <Page Update="Utility\Styles.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

</Project>
